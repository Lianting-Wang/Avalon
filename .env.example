# Host port used to access Avalon.
AVALON_PORT=8080

# Exact public origin used by browsers. No trailing slash.
# Local/LAN example: http://192.168.1.50:8080
# Domain example:    https://avalon.example.com
FRONTEND_URL=http://localhost:8080

# MongoDB
MONGODB_USER=avalon
MONGODB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DB_NAME=avalon

# Used to sign authentication tokens.
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
